# supabase/functions/.env としてコピーして使う（ローカル開発用。Git にはコミットしない）
#   本番は `supabase secrets set --env-file supabase/functions/.env.production` などで登録

# ---- Claude API ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 利用するモデル（最新の Sonnet 等に合わせて変更してください）
CLAUDE_MODEL=claude-sonnet-4-5

# ---- メール送信 ----
# log: 送信せずログ出力 / smtp: SMTP送信 / fail: 常に失敗（再送確認用）
MAIL_PROVIDER=log
# ローカルの Mailpit に送る場合（http://127.0.0.1:54324 で受信メールを確認できる）
#   MAIL_PROVIDER=smtp
#   SMTP_HOST=host.docker.internal
#   SMTP_PORT=54325
#   SMTP_SECURE=false
# Gmail SMTP（本番）
#   MAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=xxxx@gmail.com
#   SMTP_PASS=<Googleアカウントのアプリパスワード16桁>
MAIL_FROM=bihin-app@example.com
# 差出人名（未設定ならコード内の既定値「備品管理アプリ」）。Windows のコマンドラインから日本語を登録すると文字化けする場合があるため、通常は設定不要
# MAIL_FROM_NAME=備品管理アプリ
# 1通ごとの送信間隔(ms)と1回の最大送信数
MAIL_SEND_INTERVAL_MS=1000
MAIL_BATCH_SIZE=20

# pg_cron → send-mail 呼び出しの認証用（Vault の mail_worker_secret と同じ値）
MAIL_WORKER_SECRET=local-dev-worker-secret

# CORS 許可オリジン（本番は GitHub Pages のオリジンに限定: https://<org>.github.io）
ALLOWED_ORIGIN=*
