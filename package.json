{
  "name": "bihin-app",
  "description": "社内備品管理アプリ（GitHub Pages + Supabase + Claude API）",
  "scripts": {
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:test": "deno test --config supabase/functions/deno.json --allow-env supabase/functions",
    "test:concurrency": "node scripts/concurrency-test.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "create-admin": "node scripts/create-admin.mjs",
    "mail:flush": "node scripts/flush-mail.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pg": "^8.23.0",
    "supabase": "^2.118.0"
  },
  "private": true,
  "type": "module"
}